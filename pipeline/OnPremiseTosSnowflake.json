{
	"name": "OnPremiseTosSnowflake",
	"properties": {
		"activities": [
			{
				"name": "foreachonpremsnowflake",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('table_data')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "copy_onpremise_snowflake",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "SnowflakeV2Sink",
									"importSettings": {
										"type": "SnowflakeImportCopyCommand"
									}
								},
								"enableStaging": true,
								"stagingSettings": {
									"linkedServiceName": {
										"referenceName": "onpremiselink",
										"type": "LinkedServiceReference"
									}
								}
							},
							"inputs": [
								{
									"referenceName": "SqlServerTable2",
									"type": "DatasetReference",
									"parameters": {
										"premise": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "SnowflakeTable2",
									"type": "DatasetReference",
									"parameters": {
										"snowflake": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"variables": {
			"table_data": {
				"type": "Array",
				"defaultValue": [
					"EVENT_BOOKING",
					"EVENT_CUSTOMERSSS",
					"EVENT_TRANSACTION",
					"COUNTRY_REGION"
				]
			}
		},
		"annotations": []
	}
}